@{
    Layout = null;
    ViewData["Title"] = "Cổng Thông Tin Đăng Nhập";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Nunito', sans-serif;
            /* Hình nền trường học mờ */
            background: url('https://images.unsplash.com/photo-1523050854058-8df90110c9f1?q=80&w=2070&auto=format&fit=crop') no-repeat center center fixed;
            background-size: cover;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Lớp phủ màu tối để làm nổi bật form */
        .overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.95); /* Màu trắng đục */
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            width: 100%;
            max-width: 450px;
            position: relative;
            z-index: 2; /* Nổi lên trên lớp phủ */
            padding: 2rem;
        }

        .brand-logo {
            width: 80px;
            height: 80px;
            background: #0d6efd;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
            color: white;
            font-size: 40px;
        }

        .form-floating input:focus {
            box-shadow: none;
            border-color: #0d6efd;
        }

        .btn-login {
            background: linear-gradient(45deg, #0d6efd, #0a58ca);
            border: none;
            padding: 12px;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3);
        }

        .login-footer {
            margin-top: 1.5rem;
            text-align: center;
            font-size: 0.9rem;
            color: #6c757d;
        }
    </style>
</head>

<body>

    <div class="overlay"></div>

    <div class="login-card">
        <div class="text-center mb-4">
            <div class="brand-logo">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <h4 class="fw-bold text-primary">CỔNG THÔNG TIN</h4>
            <p class="text-muted">Hệ thống Quản lý Học sinh & Đào tạo</p>
        </div>

        <form id="loginForm" class="needs-validation" novalidate>
            
            <div class="alert alert-danger align-items-center" id="errorMessage" style="display:none;" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <div id="errorText">Thông tin đăng nhập không đúng</div>
            </div>

            <div class="form-floating mb-3">
                <input type="text" class="form-control" id="username" placeholder="Mã số học sinh/Giáo viên" required>
                <label for="username"><i class="bi bi-person me-1"></i> Tên đăng nhập / Mã số</label>
            </div>

            <div class="form-floating mb-3">
                <input type="password" class="form-control" id="password" placeholder="Mật khẩu" required>
                <label for="password"><i class="bi bi-lock me-1"></i> Mật khẩu</label>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="rememberMe">
                    <label class="form-check-label text-secondary" for="rememberMe">Ghi nhớ</label>
                </div>
                <a href="#" class="text-decoration-none small text-primary">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-login" id="btnLogin">
                ĐĂNG NHẬP HỆ THỐNG
            </button>

            <div class="login-footer">
                &copy; @DateTime.Now.Year - Trường THCS<br>
                <span class="small">Hỗ trợ kỹ thuật: 098x.xxx.xxx</span>
            </div>
        </form>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const loginForm = document.getElementById('loginForm');

            loginForm.addEventListener('submit', async function(event) {
                event.preventDefault(); 

                const username = document.getElementById('username').value;
                const password = document.getElementById('password').value;
                const btnLogin = document.getElementById('btnLogin');
                const errorMsg = document.getElementById('errorMessage');
                const errorText = document.getElementById('errorText');

                // Reset trạng thái
                errorMsg.style.display = 'none';
                btnLogin.disabled = true;
                btnLogin.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang xử lý...';

                try {
                    // 1. Gọi API Login
                    const response = await fetch('/api/Auth/login', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ username: username, password: password })
                    });

                    if (response.ok) {
                        const data = await response.json();

                        // 2. Lưu Token (vào LocalStorage VÀ Cookie)
                        localStorage.setItem('jwtToken', data.token);
                        document.cookie = `X-Access-Token=${data.token}; path=/; max-age=10800; SameSite=Strict`;

                        // 3. ĐIỀU HƯỚNG THÔNG MINH DỰA TRÊN ROLE
                        // Kiểm tra danh sách Roles trả về từ API
                        if (data.roles && (data.roles.includes("Admin") || data.roles.includes("Teacher"))) {
                            // Nếu là Admin/GV -> Vào trang quản trị
                            window.location.href = '/Admin/Home/Index'; // Hoặc đường dẫn Admin của bạn
                        } else {
                            // Nếu là Học sinh -> Vào trang Dashboard cá nhân
                            window.location.href = '/Home/Index';
                        }

                    } else {
                        // Xử lý lỗi đăng nhập (401)
                        const resData = await response.json().catch(() => ({})); 
                        errorText.innerText = resData.message || "Tài khoản hoặc mật khẩu không chính xác.";
                        errorMsg.style.display = 'flex';
                        btnLogin.disabled = false;
                        btnLogin.innerText = "ĐĂNG NHẬP HỆ THỐNG";
                    }
                } catch (error) {
                    console.error(error);
                    errorText.innerText = "Không thể kết nối đến máy chủ.";
                    errorMsg.style.display = 'flex';
                    btnLogin.disabled = false;
                    btnLogin.innerText = "ĐĂNG NHẬP HỆ THỐNG";
                }
            });
        });
    </script>

</body>
</html>