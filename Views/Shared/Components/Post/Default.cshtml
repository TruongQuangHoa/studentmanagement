@using StudentManagement.Models;
@model IList<tblPost>
@using StudentManagement.Utilities;

<div class="col-12">
    <div class="card">
        <div class="row">
            <div class="card-head-row">
                @{
                    var firstPost = Model.Take(1).FirstOrDefault();
                    if (firstPost != null)
                    {
                        <div class="card card-post card-round"
                            style="height: 100%; width: 100%; max-height: 900px;padding-top: 15px;">
                            <img class="card-img-top mx-auto d-block" src="@firstPost.Images" alt="Ảnh bài viết" style="object-fit: cover; height: 400px; width: 95%;
                                                             border-radius: 10px;" />

                            <div class="card-body">
                                <div class="separator-solid mb-2"></div>

                                <h3 class="card-title fw-bold">
                                    <a href="#">@firstPost.Title</a>
                                </h3>

                                <p class="card-text" style="font-size: 15px; font-weight: bold;">
                                    @firstPost.Abstract
                                </p>

                                <p class="card-text">
                                    @firstPost.Contents
                                </p>

                                <div class="d-flex align-items-center mb-3">
                                    <div class="info-post ms-3" style="margin-left: 320px;">
                                        <p class="username mb-0 fw-bold" style="margin-left: 320px;">Tác giả: Ban truyền thông
                                        </p>
                                        <p class="date text-muted mb-0" style="margin-left: 320px;"> Ngày đăng:
                                            @firstPost.CreatedDate</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Không có bài viết nào.</p>
                    }
                }
            </div>
        </div>
    </div>
</div>