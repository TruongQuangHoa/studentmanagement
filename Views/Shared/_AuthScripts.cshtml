<script>
    function parseJwt(token) {
        var base64Url = token.split('.')[1];
        var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
        var jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) {
            return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
        }).join(''));
        return JSON.parse(jsonPayload);
    }

    document.addEventListener("DOMContentLoaded", function() {
        const token = localStorage.getItem('jwtToken');

        if (!token) {
            // Nếu không phải trang login thì đá về login
            if (!window.location.href.includes("/Account/Login")) {
                 window.location.href = '/Account/Login';
            }
            return;
        }

        try {
            const userPayload = parseJwt(token);
            
            // 1. Lấy thông tin từ Token (Chú ý tên key phải khớp với AuthController)
            // Claim tùy chỉnh thường viết thường hoặc giữ nguyên tùy thư viện, ta check cả 2
            const fullName = userPayload.FullName || userPayload.fullname || userPayload.unique_name || "Người dùng";
            const avatar = userPayload.Avatar || userPayload.avatar || "/admin/assets/img/profile-img.jpg";
            const role = userPayload.role || "Học sinh";

            // 2. Gán vào Header (Menu trên cùng)
            const headerName = document.getElementById('headerName');
            const headerAvatar = document.getElementById('headerAvatar');
            
            if (headerName) headerName.innerText = fullName;
            if (headerAvatar) headerAvatar.src = avatar;

            // 3. Gán vào Dropdown (Menu xổ xuống)
            const dropdownName = document.getElementById('dropdownName');
            const dropdownRole = document.getElementById('dropdownRole');

            if (dropdownName) dropdownName.innerText = fullName;
            if (dropdownRole) dropdownRole.innerText = Array.isArray(role) ? role[0] : role; // Role có thể là mảng

        } catch (e) {
            console.error("Token invalid", e);
            // logout(); // Tạm comment để debug
        }
    });

    function logout() {
        localStorage.removeItem('jwtToken');
        document.cookie = "X-Access-Token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
        window.location.href = '/Account/Login';
    }
</script>