<main id="main" class="main">
    <section class="section dashboard">
        <div class="row">

            <!-- Left side columns -->
            <div class="col-lg-8">
                <div class="row">
                    <!-- Reports -->
                    @await Component.InvokeAsync("Post")
                </div>
            </div>
            <!-- End Left side columns -->

            @* ======= CỘT THANH BÊN (4/12) ======= *@
            <div class="col-lg-4">
                @* Khối 1: Hoạt động *@
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Người dùng đang hoạt động</h5>
                        <div class="activity">
                            <div class="activity-item d-flex">
                                <div class="activite-label">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
                                <i class='bi bi-circle-fill activity-badge text-success align-self-start'></i>
                                <div class="activity-content">
                                    <span> - Đã online 1 phút</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Khối 2: Thông Báo Khác (TĨNH) - ĐÃ SỬA ĐƯỜNG DẪN *@
                <div class="card">
                    <div class="card-body pb-0">
                        <h5 class="card-title"><span>Bài đăng khác</span></h5>
                        <div class="news">

                            <div class="post-item clearfix">
                                <img src="/assets/img/1.jpg" alt="Thumbnail"
                                    style="width: 80px; height: 60px; object-fit: cover;">

                                <h4><a href="/assets/img/slide-1.jpg" target="_blank">Cập nhật TKB tuần tới</a></h4>
                                <p>Lưu ý về sự thay đổi phòng học...</p>
                            </div>

                            <div class="post-item clearfix">
                                <img src="/assets/img/2.jpg" alt="Thumbnail"
                                    style="width: 80px; height: 60px; object-fit: cover;">
                                <h4><a href="/assets/img/slide-2.jpg" target="_blank">Đăng ký câu lạc bộ</a></h4>
                                <p>Thời hạn đăng ký các CLB mới đã mở...</p>
                            </div>

                        </div>
                    </div>
                </div>

                @* Khối 3: HỖ TRỢ HỌC TẬP *@
                <div class="card">
                    <div class="card-header bg-white border-bottom fw-bold p-3">
                        Hỗ trợ học tập
                    </div>
                    <div class="card-body p-3">

                        <p class="fw-bold mb-1 mt-2">1. Văn Phòng & Quản Lý:</p>
                        <ul class="list-group list-group-flush border-bottom mb-3">
                            <li class="list-group-item p-1 border-0">
                                <span class="fw-bold">- Văn phòng Đoàn/Giáo vụ:</span> Cô Võ Thị Anh Mai, SĐT:
                                0326466481
                            </li>
                            <li class="list-group-item p-1 border-0">
                                <span class="fw-bold">- Tư vấn hướng nghiệp:</span> Cô Hà Thị Thúy, SĐT: 0917742789
                            </li>
                            <li class="list-group-item p-1 border-0">
                                <span class="fw-bold">- Phòng thiết bị:</span> Cô Nguyễn Thị Mai Anh, SĐT:
                                0943603126
                            </li>
                            <li class="list-group-item p-1 border-0">
                                <span class="fw-bold">- Thư viện:</span> Cô Lê Thị Thu Hiền, SĐT: 0977346339
                            </li>
                        </ul>
                        <p class="fw-bold mb-1">2. Tổ chuyên Môn:</p>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item p-1 border-0">
                                <span class="fw-bold">- Tổ Ngoại ngữ:</span> Thầy Lê Hùng Việt, SĐT: 0941492628
                            </li>
                            <li class="list-group-item p-1 border-0">
                                <span class="fw-bold">- Tổ Tin học:</span> Thầy Trần Hoài Nam, SĐT: 0979796208
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
    </section>
</main>