@model IEnumerable<StudentManagement.Models.UserAccountViewModel>

@{
    ViewData["Title"] = "Quản Lý Tài Khoản Hệ Thống";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">

    <div class="pagetitle">
        <h1>Quản Lý Tài Khoản</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="#">Admin</a></li>
                <li class="breadcrumb-item active">Tài Khoản Học Sinh</li>
            </ol>
        </nav>
    </div>

    <section class="section">
        <div class="row">
            <div class="col-lg-12">

                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Danh Sách Tài Khoản Đăng Nhập</h5>
                        
                        @if (TempData["Message"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                @TempData["Message"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <table class="table table-hover datatable">
                            <thead>
                                <tr>
                                    <th>Tài khoản (Mã HS)</th>
                                    <th>Email</th>
                                    <th class="text-center">Trạng Thái</th>
                                    <th class="text-center">Chức Năng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="fw-bold">@item.UserName</td>
                                        <td>@item.Email</td>
                                        <td class="text-center">
                                            @if (item.IsLocked)
                                            {
                                                <span class="badge bg-danger">Đang Khóa</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Hoạt Động</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <a asp-action="ResetPassword" asp-route-id="@item.UserName" 
                                               class="btn btn-primary btn-sm" title="Đặt lại mật khẩu">
                                                <i class="bi bi-key-fill"></i> Reset Pass
                                            </a>

                                            @if (item.IsLocked)
                                            {
                                                <a asp-action="ToggleLockStatus" asp-route-id="@item.UserName" 
                                                   class="btn btn-success btn-sm"
                                                   onclick="return confirm('Mở khóa tài khoản này?')" title="Mở khóa">
                                                    <i class="bi bi-unlock-fill"></i> Mở Khóa
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-action="ToggleLockStatus" asp-route-id="@item.UserName" 
                                                   class="btn btn-danger btn-sm"
                                                   onclick="return confirm('Bạn có chắc muốn KHÓA tài khoản này không?')" title="Khóa tài khoản">
                                                    <i class="bi bi-lock-fill"></i> Khóa
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>
                </div>

            </div>
        </div>
    </section>

</main>