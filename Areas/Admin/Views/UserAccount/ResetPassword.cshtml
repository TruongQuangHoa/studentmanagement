@model string
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    // Đảm bảo đường dẫn Layout đúng với giao diện Admin của bạn
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h1>Quản lý tài khoản</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="UserAccount">Danh sách</a></li>
                <li class="breadcrumb-item active">Reset Mật khẩu</li>
            </ol>
        </nav>
    </div>

    <section class="section">
        <div class="row">
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Tài khoản: <span class="text-primary fw-bold">@Model</span></h5>

                        <form asp-action="ResetPassword" asp-controller="UserAccount" method="post">
                            <input type="hidden" name="id" value="@Model" />
                            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">Mật khẩu mới</label>
                                <input type="text" name="newPassword" class="form-control" required value="Hocsinh@123">
                                <div class="form-text text-muted">Mật khẩu mặc định gợi ý: Hocsinh@123</div>
                            </div>

                            <div asp-validation-summary="All" class="text-danger small"></div>

                            <div class="mt-4">
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-check-circle"></i> Xác nhận đổi
                                </button>
                                
                                @if (!string.IsNullOrEmpty(ViewBag.ReturnUrl))
                                {
                                    <a href="@ViewBag.ReturnUrl" class="btn btn-secondary">Quay lại</a>
                                }
                                else
                                {
                                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                                }
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>