@model StudentManagement.Models.tblDepartment
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<main id="main" class="main">
    <div class="pagetitle">
        <h2>Sửa thông tin bộ môn</h2>
    </div>
    <div class="container shadow p-5">
        <form method="Post" asp-action="Edit">
            <div class="form-row">
                <input type="hidden" asp-for="DepartmentID" />
                <div class="form-group col-md-6 mb-3">
                    <lable>Tên bộ môn</lable>
                    <input type="text" class="form-control" asp-for="DepartmentName" placeholder="Tên bộ môn..."
                        required>
                    <span asp-validation-for="DepartmentName" class="alert-danger"></span>
                </div>

                <div class="form-group col-md-6 mb-3">
                    <label>Mô tả</label>
                    <input type="text" class="form-control" asp-for="Description" placeholder="Nhập mô tả..." required>
                    <span asp-validation-for="Description" class="alert-danger"></span>
                </div>

                <div class="form-group col-md-6 mb-3">
                    <label>
                        @Html.CheckBox("IsActive", Model.IsActive)
                        Hiển thị
                    </label>
                </div>
            </div>
            <a asp-controller="Department" asp-action="Index" class="btn btn-lg btn-warning p-2">
                <i class="bi bi-arrow-left-circle"></i>
                Quay lại
            </a>

            <button type="submit" class="btn btn-lg btn-primary p-2">
                <i class="bi bi-file-plus-fill"></i> Lưu thông tin
            </button>
        </form>
    </div>
</main>