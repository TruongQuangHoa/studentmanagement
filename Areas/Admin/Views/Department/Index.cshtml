@using StudentManagement.Models;
@model IList<tblDepartment>
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<main id="main" class="main">
    <div class="pagetitle">
        <h2>Danh sách bộ môn</h2>
        <p>
        <section class="section dashboard">
            <div class="row">
                <div class="col-12">
                    <div class="card recent-sales overflow-auto">
                        <div class="card-body mt-4">
                            <table class="table table-borderless datatable">
                                <thead>
                                    <tr>
                                        <th class="col-1 text-center">STT</th>
                                        <th class="col-2 text-center">Tên bộ môn</th>
                                        <th class="col-3 text-center">Mô tả</th>
                                        <th class="col-1 text-center">Hiển thị</th>
                                        <th class="col-1 text-center">Chức năng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int stt = 0;
                                    }
                                    @foreach (var item in Model)
                                    {
                                        stt++;
                                        <tr>
                                            <td class="text-center" scope="row">@stt</td>
                                            <td class="text-left text-primary text-center" scope="row">
                                                <a asp-area="Admin" asp-controller="Department" asp-action="Details"
                                                    asp-route-id="@item.DepartmentID">
                                                    @item.DepartmentName
                                                </a>
                                            </td>
                                            <td class="text-center" scope="row">@item.Description</td>
                                            <td class="text-center">
                                                <form asp-area="Admin" asp-controller="Department" asp-action="ToggleStatus"
                                                    method="post">
                                                    <input type="hidden" name="id" value="@item.DepartmentID" />
                                                    <div class="form-check form-switch d-flex justify-content-center">
                                                        <input class="form-check-input toggle-status-switch" type="checkbox"
                                                            name="IsActive" @(item.IsActive ? "checked" : "")
                                                            onchange="this.form.submit()" />
                                                    </div>
                                                </form>
                                            </td>
                                            <td class="text-center" scope="row">
                                                <a asp-area="Admin" asp-controller="Department" asp-action="Edit"
                                                    asp-route-id="@item.DepartmentID" class="btn btn-primary btn-sm"
                                                    title="Edit the department"><i class="bi bi-pencil"></i></a>
                                                <a asp-area="Admin" asp-controller="Department" asp-action="Delete"
                                                    asp-route-id="@item.DepartmentID" class="btn btn-danger btn-sm"
                                                    title="Delete the department"><i class="bi bi-trash"></i></a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        </p>
    </div>
</main>