@model StudentManagement.Models.tblDepartment
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<main id="main" class="main">
    <div class="pagetitle">
        <h2>Xóa thông tin bộ môn</h2>
    </div>
    <div class="form-row">
        <div class="form-group col-md-6">
            <label asp-for="DepartmentID">Mã bộ môn</label>
            <input type="text" class="form-control mb-3" asp-for="DepartmentID" disabled />
        </div>

        <div class="form-group col-md-6">
            <label asp-for="DepartmentName">Tên bộ môn</label>
            <input type="text" class="form-control mb-3" asp-for="DepartmentName" disabled />
        </div>
    </div>
    <form asp-action="Delete" method="Post">
        <input type="hidden" asp-for="DepartmentID" />
        <a class="btn btn-lg btn-warning p-2 mr-5" href="javascript:history.back()">
            <i class="bi bi-arrow-left-circle"></i> Quay lại
        </a>

        <button type="submit" class="btn btn-lg btn-danger p-2">
            <i class="bi bi-trash"></i> Xóa
        </button>
    </form>
</main>