@model StudentManagement.Models.tblYearSemester
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<main id="main" class="main">
    <div class="pagetitle">
        <h2>Sửa thông tin năm học, học kỳ</h2>
    </div>
    <div class="container shadow p-5">
        <form method="Post" asp-action="Edit">
            <div class="form-row">
                <input type="text" class="form-contro" asp-for="YearSemesterID" type="hidden">
                <div class="form-group col-md-6 mb-3">
                    <label>Tên học kỳ</label>
                    <input type="text" class="form-control" asp-for="SemesterName" placeholder="Nhập tên học kỳ..."
                        required>
                    <span asp-validation-for="SemesterName" class="alert-danger"></span>
                </div>


                <div class="form-group col-md-6 mb-3">
                    <label>Năm học</label>
                    <input type="text" class="form-control" asp-for="SchoolYear" placeholder="Nhập năm học ..."
                        required>
                    <span asp-validation-for="SchoolYear" class="alert-danger"></span>
                </div>

                <div class="form-group col-md-6 mb-3">
                    <label>
                        @Html.CheckBox("IsActive", Model.IsActive)
                        Hiển thị
                    </label>
                </div>
            </div>
            <a asp-controller="YearSemester" asp-action="Index" class="btn btn-lg btn-warning p-2">
                <i class="bi bi-arrow-left-circle"></i>
                Quay lại
            </a>

            <button type="submit" class="btn btn-lg btn-primary p-2">
                <i class="bi bi-file-plus-fill"></i> Lưu thông tin
            </button>
        </form>
    </div>
</main>