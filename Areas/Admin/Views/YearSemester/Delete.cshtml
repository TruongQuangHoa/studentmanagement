@model StudentManagement.Models.tblYearSemester
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<main id="main" class="main">
    <div class="pagetitle">
        <h2>Xóa năm học, học kỳ</h2>
    </div>
    <div class="form-row">
        <div class="form-group col-md-6">
            <label asp-for="YearSemesterID">Mã năm học, học kỳ</label>
            <input type="text" class="form-control mb-3" asp-for="YearSemesterID" disabled />
        </div>

        <div class="form-group col-md-6">
            <label asp-for="SemesterName">Tên học kỳ</label>
            <input type="text" class="form-control mb-3" asp-for="SemesterName" disabled />
        </div>
        <div class="form-group col-md-6">
            <label asp-for="SchoolYear">Năm học</label>
            <input type="text" class="form-control mb-3" asp-for="SchoolYear" disabled />
        </div>
    </div>
    <!-- Begin Form -->
    <form asp-action="Delete" method="Post">
        <input type="hidden" asp-for="YearSemesterID" />
        <a class="btn btn-lg btn-warning p-2 mr-5" href="javascript:history.back()">
            <i class="bi bi-arrow-left-circle"></i> Quay lại
        </a>
        <button type="submit" class="btn btn-lg btn-danger p-2">
            <i class="bi bi-trash"></i> Xóa
        </button>
    </form>
    <!-- End Form -->
</main>