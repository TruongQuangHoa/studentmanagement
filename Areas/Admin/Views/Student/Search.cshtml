@* @model List<StudentManagement.Models.tblStudent>

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var defaultAvatar = Url.Content("~/assets/img/kaiadmin/user.jpg");
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2>Học sinh sau tìm kiếm</h2>
    </div>

    <section class="section dashboard">
        <div class="row">
            <div class="col-12">
                <div class="card recent-sales overflow-auto">
                    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                        <a href="@Url.Action("Index", "QLHocSinh", new { area = "Admin" })"
                           class="btn btn-secondary btn-sm d-flex align-items-center gap-1"
                           title="Quay lại danh sách">
                            <i class="bi bi-arrow-left"></i> Quay lại
                        </a>
                    </div>

                    <div class="container mt-4">
                        <div class="row">
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var student in Model)
                                {
                                    <div class="col-md-3 text-center mb-4">
                                        <div class="avatar-container">
                                            <img src="@((!string.IsNullOrEmpty(student.Images)) 
                                                    ? Url.Content(student.Images) 
                                                    : defaultAvatar)"
                                                 alt="Ảnh học sinh"
                                                 class="img-fluid rounded shadow"
                                                 style="max-width: 200px; border: 3px solid #2c3e50;">
                                        </div>
                                    </div>

                                    <div class="col-md-9 mb-4">
                                        <div class="card shadow-sm">
                                            <div class="card-header bg-primary text-white">
                                                <h4 class="mb-0 font-weight-bold">THÔNG TIN HỌC SINH</h4>
                                            </div>
                                            <div class="card-body">
                                                <div class="row">
                                                    <!-- Cột trái -->
                                                    <div class="col-md-6">
                                                        <div class="form-group mb-3">
                                                            <label class="font-weight-bold text-dark">Mã học sinh:</label>
                                                            <div class="form-control-plaintext border-bottom pb-2">
                                                                <strong>@student.StudentID</strong>
                                                            </div>
                                                        </div>

                                                        <div class="form-group mb-3">
                                                            <label class="font-weight-bold text-dark">Họ và tên:</label>
                                                            <div class="form-control-plaintext border-bottom pb-2">
                                                                <strong>@student.FullName</strong>
                                                            </div>
                                                        </div>

                                                        <div class="form-group mb-3">
                                                            <label class="font-weight-bold text-dark">Địa chỉ:</label>
                                                            <div class="form-control-plaintext border-bottom pb-2">
                                                                @student.Address
                                                            </div>
                                                        </div>

                                                        <div class="form-group mb-3">
                                                            <label class="font-weight-bold text-dark">Dân tộc:</label>
                                                            <div class="form-control-plaintext border-bottom pb-2">
                                                                @student.Nation
                                                            </div>
                                                        </div>

                                                        <div class="form-group mb-3">
                                                            <label class="font-weight-bold text-dark">Tôn giáo:</label>
                                                            <div class="form-control-plaintext border-bottom pb-2">
                                                                @student.Religion
                                                            </div>
                                                        </div>

                                                        <div class="form-group mb-3">
                                                            <label class="font-weight-bold text-dark">Giới tính:</label>
                                                            <div class="d-flex mt-2">
                                                                <div class="me-4">
                                                                    <div class="form-check">
                                                                        <input class="form-check-input" type="radio"
                                                                               id="male-@student.StudentID"
                                                                               @(student.Gender == "Nam" ? "checked" : "") disabled />
                                                                        <label class="form-check-label font-weight-bold @(student.Gender == "Nam" ? "text-primary" : "text-muted")"
                                                                               for="male-@student.StudentID">
                                                                            Nam
                                                                        </label>
                                                                    </div>
                                                                </div>
                                                                <div>
                                                                    <div class="form-check">
                                                                        <input class="form-check-input" type="radio"
                                                                               id="female-@student.StudentID"
                                                                               @(student.Gender == "Nữ" ? "checked" : "") disabled />
                                                                        <label class="form-check-label font-weight-bold @(student.Gender == "Nữ" ? "text-primary" : "text-muted")"
                                                                               for="female-@student.StudentID">
                                                                            Nữ
                                                                        </label>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Cột phải -->
                                                    <div class="col-md-6">
                                                        <div class="form-group mb-3">
                                                            <label class="font-weight-bold text-dark">Ngày sinh:</label>
                                                            <div class="form-control-plaintext border-bottom pb-2">
                                                                @(student.Birth.HasValue ? student.Birth.Value.ToString("dd/MM/yyyy") : "")
                                                            </div>
                                                        </div>

                                                       <div class="form-group mb-3">
    <label class="font-weight-bold text-dark">Lớp:</label>
    <div class="form-control-plaintext border-bottom pb-2">
        @{
            var activeClass = student.HocSinhLopHocs?.FirstOrDefault(hsl => hsl.IsActive)?.lopHoc;
        }
        @activeClass?.ClassName ?? "Không có"
    </div>
</div>


                                                        <div class="form-group mb-3">
                                                            <label class="font-weight-bold text-dark">Trạng thái:</label>
                                                            <div class="form-control-plaintext border-bottom pb-2">
                                                                <span class="badge @(student.StatusStudent == "Đang học" ? "bg-success" : "bg-warning")">
                                                                    @student.StatusStudent
                                                                </span>
                                                            </div>
                                                        </div>

                                                        <div class="form-group mb-3">
                                                            <label class="font-weight-bold text-dark">Số điện thoại:</label>
                                                            <div class="form-control-plaintext border-bottom pb-2">
                                                                @student.NumberPhone
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }else
                            {
                                <p class="text-center">Không tìm thấy học sinh nào.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main> *@
