@using System
@using StudentManagement.Models;
@model IList<tblStudent>
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Quản lý Học sinh";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2>Danh sách học sinh</h2>
        <section class="section dashboard">
            <div class="row">
                <div class="col-12">
                    <div class="card recent-sales overflow-auto">
                        <div class="card-header d-flex flex-wrap align-items-center justify-content-end gap-3 p-3">
                            @{
                                var currentClassId = Context.Request.Query["classId"].FirstOrDefault();
                                var lopHocList = ViewBag.LopHocList as SelectList;
                            }
                        </div>

                        <div class="card-body mt-4">
                            <table class="table table-borderless datatable">
                                <thead>
                                    <tr>
                                        <th class="text-center">STT</th>
                                        <th class="text-center">Mã học sinh</th>
                                        <th class="text-center">Họ và tên</th>
                                        <th class="text-center">Ngày sinh</th>
                                        <th class="text-center">Giới tính</th>
                                        <th class="text-center">Địa chỉ</th>
                                        <th class="text-center">Tên lớp</th>
                                        <th class="text-center">Tình trạng học sinh</th>
                                        <th class="text-center">Số điện thoại</th>
                                        <th class="text-center">Hình ảnh</th>
                                        <th class="text-center">Hiển thị</th>
                                        <th class="text-center">Chức năng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int stt = 0;
                                    }
                                    @foreach (var item in Model)
                                    {
                                        stt++;
                                        <tr>
                                            <td class="text-center">@stt</td>
                                            <td class="text-center">@item.StudentID</td>
                                            <td class="text-center text-primary">
                                                <a asp-area="Admin" asp-controller="QLHocSinh" asp-action="Details"
                                                    asp-route-id="@item.ID">
                                                    @item.FullName
                                                </a>
                                            </td>
                                            <td class="text-center">
                                                @(item.Birth.HasValue? item.Birth.Value.ToString("dd/MM/yyyy") : "")
                                            </td>
                                            <td class="text-center">@item.Gender</td>
                                            <td class="text-center">@item.Address</td>
                                            <td class="text-center">
                                                @(item.studentclass?.FirstOrDefault(hsl =>
                                                                                            hsl.IsActive)?._class?.ClassName ?? "Không có")
                                            </td>
                                            <td class="text-center">@item.StatusStudent</td>
                                            <td class="text-center">@item.NumberPhone</td>
                                            <td class="text-center">
                                                <img src="@item.Images" alt="Image" width="100" height="100" />
                                            </td>
                                            <td class="text-center">
                                                <form asp-area="Admin" asp-controller="Student" asp-action="ToggleStatus"
                                                    method="post">
                                                    <input type="hidden" name="id" value="@item.ID" />
                                                    <div class="form-check form-switch d-flex justify-content-center">
                                                        <input class="form-check-input toggle-status-switch" type="checkbox"
                                                            name="IsActive" @(item.IsActive ? "checked" : "")
                                                            onchange="this.form.submit()" />
                                                    </div>
                                                </form>
                                            </td>
                                            <td class="text-center">
                                                <a asp-area="Admin" asp-controller="Student" asp-action="Edit"
                                                    asp-route-id="@item.ID" class="btn btn-primary btn-sm"
                                                    title="Edit the student"><i class="bi bi-pencil"></i></a>
                                                <a asp-area="Admin" asp-controller="Student" asp-action="Delete"
                                                    asp-route-id="@item.ID" class="btn btn-danger btn-sm"
                                                    title="Delete the student"><i class="bi bi-trash"></i></a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</main>

<script>
    document.getElementById('btn-Upload').addEventListener('click', function () {
        const fileInput = document.getElementById('file-input');
        fileInput.click();
        fileInput.addEventListener('change', function () {
            if (fileInput.files.length > 0) {
                fileInput.closest('form').submit();
            }
        });
    });

    // JavaScript để xử lý lọc khi chọn lớp
    document.getElementById('classFilterDropdown').addEventListener('change', function () {
        document.getElementById('filterForm').submit();
    });

    // JavaScript để xử lý nút "Tải Excel lớp đã chọn"
    document.getElementById('exportByClassForm').addEventListener('submit', function (event) {
        var selectedClassId = document.getElementById('classFilterDropdown').value;
        if (selectedClassId === "" || selectedClassId === "0") { // Kiểm tra nếu không có lớp nào được chọn
            alert("Vui lòng chọn một lớp cụ thể để tải Excel theo lớp.");
            event.preventDefault(); // Ngăn chặn form gửi đi
        } else {
            document.getElementById('selectedClassIdForExport').value = selectedClassId;
        }
    });
</script>