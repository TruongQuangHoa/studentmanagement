@model IList<StudentManagement.Models.tblClass>
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2>Danh sách lớp học</h2>
    </div>

    <section class="section dashboard">
        <div class="row">
            <div class="col-12">
                <div class="card recent-sales overflow-auto">
                    <div class="card-body mt-4">
                        <table class="table table-borderless datatable">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Mã lớp</th>
                                    <th>Tên lớp</th>
                                    <th>Khối</th>
                                    <th>Số lượng tối đa</th>
                                    <th>Số lượng hiện tại</th>
                                    <th>Năm học</th>
                                    <th>Niên khóa</th>
                                    <th>Hiển thị</th>
                                    <th>Chức năng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int stt = 0;
                                }
                                @foreach (var item in Model)
                                {
                                    stt++;
                                    <tr>
                                        <td>@stt</td>
                                        <td>@item.ClassID</td>
                                        <td>
                                            <a asp-area="Admin" asp-controller="Class" asp-action="Edit" asp-route-id="@item.ClassID">
                                                @item.ClassName
                                            </a>
                                        </td>
                                        <td>@item.grade?.GradeName</td>
                                        <td>@item.MaxStudents</td>
                                        <td>@item.CurrentStudents</td>
                                        <td>@item.SchoolYear</td>
                                        <td>
                                            @(item.cohort != null ? item.cohort.StartYear + "-" + item.cohort.EndYear + " - Khóa " + item.cohort.CohortName : "Chưa có khóa học")
                                        </td>
                                        <td>
                                            <form asp-area="Admin" asp-controller="Class" asp-action="ToggleStatus" method="post">
                                                <input type="hidden" name="id" value="@item.ClassID" />
                                                <input type="checkbox" @(item.IsActive ? "checked" : "") onchange="this.form.submit()" />
                                            </form>
                                        </td>
                                        <td>
                                            <a asp-area="Admin" asp-controller="Class" asp-action="Edit" asp-route-id="@item.ClassID" class="btn btn-primary btn-sm"><i class="bi bi-pencil"></i></a>
                                            <a asp-area="Admin" asp-controller="Class" asp-action="Delete" asp-route-id="@item.ClassID" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
