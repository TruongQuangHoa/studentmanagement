@model IList<StudentManagement.Models.tblClass>
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2>Danh sách lớp học</h2>
    </div>

    <section class="section dashboard">
        <div class="row">
            <div class="col-12">
                <div class="card recent-sales overflow-auto">
                    <div class="card-body mt-4">
                        <table class="table table-borderless datatable">
                            <thead>
                                <tr>
                                    <th class="col-1 text-center">STT</th>
                                    <th class="col-1 text-center">Khối</th>
                                    <th class="col-1 text-center">Tên lớp</th>
                                    <th class="col-1 text-center">Số lượng tối đa</th>
                                    <th class="col-1 text-center">Số lượng hiện tại</th>
                                    <th class="col-1 text-center">Năm học</th>
                                    <th class="col-2 text-center">Niên khóa</th>
                                    <th class="col-1 text-center">Hiển thị</th>
                                    <th class="col-1 text-center">Chức năng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int stt = 0;
                                }
                                @foreach (var item in Model)
                                {
                                    stt++;
                                    <tr>
                                        <td class="text-center">@stt</td>
                                        <td class="text-center">@item.grade?.GradeName</td>
                                        <td class="text-center">
                                            <a asp-area="Admin" asp-controller="Class" asp-action="Edit"
                                                asp-route-id="@item.ClassID">
                                                @item.ClassName
                                            </a>
                                        </td>
                                        <td class="text-center">@item.MaxStudents</td>
                                        <td class="text-center">@item.CurrentStudents</td>
                                        <td class="text-center">@item.SchoolYear</td>
                                        <td class="text-center">
                                            @(item.cohort != null ? item.cohort.StartYear + "-" + item.cohort.EndYear + " -                              Khóa " + item.cohort.CohortName : "Chưa có khóa học")
                                        </td>
                                        <td class="text-center">
                                            <form asp-area="Admin" asp-controller="Class" asp-action="ToggleStatus"
                                                method="post">
                                                <input type="hidden" name="id" value="@item.ClassID" />
                                                <div class="form-check form-switch d-flex justify-content-center">
                                                    <input class="form-check-input toggle-status-switch" type="checkbox"
                                                        name="IsActive" @(item.IsActive ? "checked" : "")
                                                        onchange="this.form.submit()" />
                                                </div>
                                            </form>
                                        </td>
                                        <td class="text-center">
                                            <a asp-area="Admin" asp-controller="Class" asp-action="Edit"
                                                asp-route-id="@item.ClassID" class="btn btn-primary btn-sm" title="Edit the class"><i
                                                    class="bi bi-pencil"></i></a>
                                            <a asp-area="Admin" asp-controller="Class" asp-action="Delete"
                                                asp-route-id="@item.ClassID" class="btn btn-danger btn-sm" title="Delete the class"><i
                                                    class="bi bi-trash"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>