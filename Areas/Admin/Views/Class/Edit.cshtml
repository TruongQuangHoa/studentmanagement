@model StudentManagement.Models.tblClass
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2>Sửa thông tin lớp học</h2>
    </div>

    <!-- Begin Form -->
    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="ClassID" />

        <div class="row">
            <!-- Tên lớp -->
            <div class="col-md-6 mb-3">
                <label>Tên lớp</label>
                <input type="text" class="form-control" asp-for="ClassName" required />
            </div>

            <!-- Khối (readonly) -->
            <div class="col-md-6 mb-3">
                <label>Khối</label>
                <input type="text" class="form-control" value="@Model.grade?.GradeName" readonly />
            </div>

            <!-- Khóa học (readonly) -->
            <div class="col-md-6 mb-3">
                <label>Khóa học</label>
                <input type="text" class="form-control" value="@Model.cohort?.CohortName" readonly />
            </div>

            <!-- Số lượng tối đa -->
            <div class="col-md-6 mb-3">
                <label>Số lượng tối đa</label>
                <input type="number" class="form-control" asp-for="MaxStudents" required />
            </div>

            <!-- Số lượng hiện tại -->
            <div class="col-md-6 mb-3">
                <label>Số lượng hiện tại</label>
                <input type="number" class="form-control" asp-for="CurrentStudents" required />
            </div>

            <!-- Hiển thị -->
            <div class="col-md-6 mb-3">
                <label>Hiển thị</label><br />
                <input type="checkbox" asp-for="IsActive" />
            </div>
        </div>

        <a class="btn btn-lg btn-warning p-2 mr-5" href="javascript:history.back()">
            <i class="bi bi-arrow-left-circle"></i> Quay lại
        </a>

        <button type="submit" class="btn btn-lg btn-primary p-2">
            <i class="bi bi-save"></i> Lưu thay đổi
        </button>

    </form>
    <!-- End Form -->
</main>
